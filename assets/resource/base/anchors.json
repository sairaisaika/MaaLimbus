{
  "version": 1,
  "reference_width": 1280,
  "reference_height": 720,
  "note": "每个由画面推导出来的假设都在这里登记，并由 tools/verify_anchors.py 用留档观测离线复检。roi 是 maalimbus.vision.find 使用的中心归一化框；geometry 锚点是「在某一帧上被证明过」的控件几何（用 image_sha256 对齐，换帧即报 stale，绝不静默沿用）。",
  "pages": [
    {
      "id": "map",
      "title": "楼层地图（Exploring Floor N）",
      "evidence": [
        "evidence/runtime/map-advance-20261006-014737/frame-0001.json",
        "evidence/runtime/battle-step-20261006-014432/frame-0001.json"
      ],
      "identity": [
        {
          "id": "map.floor",
          "kind": "ocr",
          "pattern": "^(?:Exploring|Before\\s+Entry)\\s+Floor\\s*([1-5])\\b",
          "roi": [0.0, 0.06, 0.30, 0.22],
          "threshold": 0.85,
          "note": "楼层号＝捕获组 1；OCR 退化（Exploring FloorT）会失配，故必须与 map.pack_name 同时成立"
        },
        {
          "id": "map.pack_name",
          "kind": "ocr",
          "pattern": "\\S",
          "roi": [0.0, 0.14, 0.30, 0.28],
          "threshold": 0.8,
          "note": "抬头下方一行＝本层主题包名（随包变化，故只要求存在文本）"
        }
      ],
      "controls": [],
      "live_derived": [
        "map_vision.node_markers(image)：节点框＝亮连通域现算，不写死坐标",
        "map_vision.flame_player(markers, image)：玩家位置＝金色火焰（mean G>120 且 G-B 最大）现算",
        "map_vision.route_decision()：无可达候选时给出拒绝原因，而不是猜一个坐标"
      ]
    },
    {
      "id": "node_panel",
      "title": "节点信息面板（Clear Rewards + Enter）",
      "evidence": ["evidence/runtime/map-probe-20261006-000748/frame-0002.json"],
      "identity": [
        {
          "id": "node_panel.rewards",
          "kind": "ocr",
          "pattern": "^Clear\\s+Rewards$",
          "roi": [0.50, 0.64, 0.68, 0.75],
          "threshold": 0.85,
          "note": "打卡片节点成功打开的面板；同时说明「点地图节点＝打开信息面板」而不是直接进战斗"
        },
        {
          "id": "node_panel.enter",
          "kind": "ocr",
          "pattern": "^Enter$",
          "roi": [0.82, 0.68, 0.95, 0.80],
          "threshold": 0.85,
          "note": "面板确认键；用 inset 随机落点（勿点边缘）"
        }
      ],
      "controls": [
        {
          "id": "node_panel.enter_button",
          "kind": "geometry",
          "verified_on": {
            "frame": "evidence/runtime/map-probe-20261006-000748/frame-0002.json",
            "box": [1668, 780, 124, 63],
            "source": "tools/map_panel_enter.py：enter_box inset 后落点 (1705,815)，实测进入 CONNECTING 过渡态"
          }
        }
      ]
    },

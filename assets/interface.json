          "label": "$team_name",
          "default": "",
          "verify": "^.{0,80}$",
          "pipeline_type": "string"
        }
      ],
      "pipeline_override": {
        "TeamLibraryConfigure": {
          "custom_action_param": {
            "name": "{name}"
          }
        }
      }
